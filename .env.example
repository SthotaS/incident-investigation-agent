# Optional environment settings. Export these in the shell before running the client.
# This file is an example; the app does not automatically load .env files.
MCP_TOOL_TIMEOUT_SECONDS=10
LOG_LEVEL=WARNING

# API model for --planner openai. Prefer --ask-key for a hidden temporary prompt.
# OPENAI_API_KEY=your-key-set-in-your-terminal
OPENAI_MODEL=gpt-4.1-mini-2025-04-14

# Request guards; API requests are counted separately from the 8-tool budget.
# These are usage limits, not a dollar spending cap. Automatic API retries are disabled.
OPENAI_TIMEOUT_SECONDS=30
MAX_API_INPUT_BYTES=131072
MAX_API_CALLS=8

# Optional absolute path. Build and run must use the same directory.
# INCIDENT_RAG_DIR=/absolute/path/to/incident-investigation-agent/data/rag

# Durable human-decision database; separate from the rebuildable FAISS index.
# INCIDENT_KNOWLEDGE_DB=/absolute/path/to/data/knowledge/incidents.sqlite3
